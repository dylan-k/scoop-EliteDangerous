{
    "version": "1.5.2",
    "description": "Tool for reading/monitoring Elite Dangerous journals for interesting objects.",
    "homepage": "https://github.com/Xjph/ObservatoryCore",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Xjph/ObservatoryCore/releases/download/v1.5.2/ObservatoryPortable.zip",
            "hash": "9d328aca6bf83162cc41a620266f13b57e2d33472a0d8da434dca2289975b1bb"
        }
    },
    "shortcuts": [
        [
            "ObservatoryCore.exe",
            "..\\Elite Dangerous Tools\\Observatory Core"
        ]
    ],
    "pre_install": [
        "# Observatory keeps core and plugin settings in Observatory.config next to the exe.",
        "# Seed it so scoop persists it as a file, not a folder. Observatory accepts {} and fills in defaults.",
        "if (!(Test-Path \"$persist_dir\\Observatory.config\") -and !(Test-Path \"$dir\\Observatory.config\")) { Set-Content \"$dir\\Observatory.config\" '{}' -NoNewline }"
    ],
    "persist": [
        "plugins",
        "Observatory.config"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/Xjph/ObservatoryCore/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v?([\\d.]+[\\-a-z]*)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Xjph/ObservatoryCore/releases/download/v$version/ObservatoryPortable.zip"
            }
        }
    }
}
