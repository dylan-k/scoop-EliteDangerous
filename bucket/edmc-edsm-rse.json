{
    "version": "1.4.3",
    "description": "EDMC plugin: Red Star Eliminator for EDSM.",
    "homepage": "https://github.com/Thurion/EDSM-RSE-for-EDMC",
    "license": "Unknown",
    "depends": "edmc",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Thurion/EDSM-RSE-for-EDMC/releases/download/ver_1.4.3/EDSM-RSE.zip",
            "hash": "805a7be14219e79ad8ce28b6d84dc9c5337db3886720c6d949ed3374c820d0b2",
            "extract_dir": "EDSM-RSE"
        }
    },
    "installer": {
        "script": [
            "# Copy the release over the plugin folder: replaces the plugin's files, keeps files it doesn't ship (your data).",
            "New-Item -ItemType Directory -Path \"$env:LocalAppData\\EDMarketConnector\\plugins\\EDSM-RSE\" -Force | Out-Null",
            "Copy-Item -Path \"$dir\\*\" -Destination \"$env:LocalAppData\\EDMarketConnector\\plugins\\EDSM-RSE\" -Recurse -Force -Exclude manifest.json,install.json"
        ]
    },
    "uninstaller": {
        "script": [
            "# Scoop runs this on update and on uninstall alike. It removes only the files this version shipped,",
            "# so data the plugin keeps in its folder (settings, databases, routes) survives both.",
            "$plugin = \"$env:LocalAppData\\EDMarketConnector\\plugins\\EDSM-RSE\"",
            "Get-ChildItem -LiteralPath $dir -Recurse -File -Exclude manifest.json,install.json | ForEach-Object {",
            "    Remove-Item -LiteralPath (Join-Path $plugin $_.FullName.Substring($dir.Length + 1)) -Force -ErrorAction SilentlyContinue",
            "}",
            "# Then remove folders left empty, deepest first.",
            "if (Test-Path -LiteralPath $plugin) {",
            "    Get-ChildItem -LiteralPath $plugin -Recurse -Directory | Sort-Object { $_.FullName.Length } -Descending |",
            "        Where-Object { -not (Get-ChildItem -LiteralPath $_.FullName -Force) } | Remove-Item -Force",
            "    if (-not (Get-ChildItem -LiteralPath $plugin -Force)) { Remove-Item -LiteralPath $plugin -Force }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://api.github.com/repos/Thurion/EDSM-RSE-for-EDMC/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^ver_([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Thurion/EDSM-RSE-for-EDMC/releases/download/ver_$version/EDSM-RSE.zip",
                "extract_dir": "EDSM-RSE"
            }
        }
    }
}
