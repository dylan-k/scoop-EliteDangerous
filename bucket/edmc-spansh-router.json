{
    "version": "3.1.0",
    "description": "EDMC plugin: Spansh neutron and road-to-riches route plotting.",
    "homepage": "https://github.com/CMDR-Kiel42/EDMC_SpanshRouter",
    "license": "Unknown",
    "depends": "edmc",
    "architecture": {
        "64bit": {
            "url": "https://github.com/CMDR-Kiel42/EDMC_SpanshRouter/releases/download/v3.1.0/EDMC_SpanshRouter_310.zip",
            "hash": "8e4cd529f7c4a900f3b0f83074a25346d25b113e763aa2a18e9b266912a49525"
        }
    },
    "installer": {
        "script": [
            "# Copy the release over the plugin folder: replaces the plugin's files, keeps files it doesn't ship (your data).",
            "New-Item -ItemType Directory -Path \"$env:LocalAppData\\EDMarketConnector\\plugins\\EDMC_SpanshRouter\" -Force | Out-Null",
            "Copy-Item -Path \"$dir\\*\" -Destination \"$env:LocalAppData\\EDMarketConnector\\plugins\\EDMC_SpanshRouter\" -Recurse -Force -Exclude manifest.json,install.json"
        ]
    },
    "uninstaller": {
        "script": [
            "# Scoop runs this on update and on uninstall alike. It removes only the files this version shipped,",
            "# so data the plugin keeps in its folder (settings, databases, routes) survives both.",
            "$plugin = \"$env:LocalAppData\\EDMarketConnector\\plugins\\EDMC_SpanshRouter\"",
            "Get-ChildItem -LiteralPath $dir -Recurse -File -Exclude manifest.json,install.json | ForEach-Object {",
            "    Remove-Item -LiteralPath (Join-Path $plugin $_.FullName.Substring($dir.Length + 1)) -Force -ErrorAction SilentlyContinue",
            "}",
            "# Then remove folders left empty, deepest first.",
            "if (Test-Path -LiteralPath $plugin) {",
            "    Get-ChildItem -LiteralPath $plugin -Recurse -Directory | Sort-Object { $_.FullName.Length } -Descending |",
            "        Where-Object { -not (Get-ChildItem -LiteralPath $_.FullName -Force) } | Remove-Item -Force",
            "    if (-not (Get-ChildItem -LiteralPath $plugin -Force)) { Remove-Item -LiteralPath $plugin -Force }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://api.github.com/repos/CMDR-Kiel42/EDMC_SpanshRouter/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v?([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CMDR-Kiel42/EDMC_SpanshRouter/releases/download/v$version/EDMC_SpanshRouter_$cleanVersion.zip"
            }
        }
    }
}
