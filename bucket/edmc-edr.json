    },
    "installer": {
        "script": [
            "New-Item -ItemType Directory -Path \"$env:LocalAppData\\EDMarketConnector\\plugins\\EDR\" -Force | Out-Null",
            "Copy-Item -Path \"$dir\\*\" -Destination \"$env:LocalAppData\\EDMarketConnector\\plugins\\EDR\" -Recurse -Force -Exclude manifest.json,install.json"
        ]
    },
    "uninstaller": {
        "script": "Remove-Item -Path \"$env:LocalAppData\\EDMarketConnector\\plugins\\EDR\" -Recurse -Force -ErrorAction SilentlyContinue"
    },
    "checkver": {
        "url": "https://api.github.com/repos/lekeno/edr/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v?([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/lekeno/edr/releases/download/v$version/EDRv$version.zip"
            }
        }
    }
