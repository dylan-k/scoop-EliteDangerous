{
    "version": "3.4.2",
    "description": "EDMC plugin: Elite Dangerous Remote (EDR) crime reports and bounty tracking.",
    "homepage": "https://github.com/lekeno/edr",
    "license": "Unknown",
    "depends": "edmc",
    "architecture": {
        "64bit": {
            "url": "https://github.com/lekeno/edr/releases/download/v3.4.2/EDRv3.4.2.zip",
            "hash": "97a1ad04193f3cca898b75cd4997193544983531fb1803902271f00990477fb8"
        }
    },
    "installer": {
        "script": [
            "# Copy the release over the plugin folder: replaces the plugin's files, keeps files it doesn't ship (your data).",
            "New-Item -ItemType Directory -Path \"$env:LocalAppData\\EDMarketConnector\\plugins\\EDR\" -Force | Out-Null",
            "Copy-Item -Path \"$dir\\*\" -Destination \"$env:LocalAppData\\EDMarketConnector\\plugins\\EDR\" -Recurse -Force -Exclude manifest.json,install.json"
        ]
    },
    "uninstaller": {
        "script": [
            "# Scoop runs this on update and on uninstall alike. It removes only the files this version shipped,",
            "# so data the plugin keeps in its folder (settings, databases, routes) survives both.",
            "$plugin = \"$env:LocalAppData\\EDMarketConnector\\plugins\\EDR\"",
            "Get-ChildItem -LiteralPath $dir -Recurse -File -Exclude manifest.json,install.json | ForEach-Object {",
            "    Remove-Item -LiteralPath (Join-Path $plugin $_.FullName.Substring($dir.Length + 1)) -Force -ErrorAction SilentlyContinue",
            "}",
            "# Then remove folders left empty, deepest first.",
            "if (Test-Path -LiteralPath $plugin) {",
            "    Get-ChildItem -LiteralPath $plugin -Recurse -Directory | Sort-Object { $_.FullName.Length } -Descending |",
            "        Where-Object { -not (Get-ChildItem -LiteralPath $_.FullName -Force) } | Remove-Item -Force",
            "    if (-not (Get-ChildItem -LiteralPath $plugin -Force)) { Remove-Item -LiteralPath $plugin -Force }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://api.github.com/repos/lekeno/edr/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v?([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/lekeno/edr/releases/download/v$version/EDRv$version.zip"
            }
        }
    }
}
