{
    "version": "7.1.0",
    "description": "EDMC plugin: converts, rename and file screenshots.",
    "homepage": "https://github.com/NoFoolLikeOne/EDMC-Screenshot",
    "license": "GPL-3.0",
    "depends": "edmc",
    "architecture": {
        "64bit": {
            "url": "https://github.com/NoFoolLikeOne/EDMC-Screenshot/archive/refs/tags/7.1.0.zip",
            "hash": "be0ba4d381b2c8f7f047828982cc48c2478aac31de31f581971de286225e8401",
            "extract_dir": "EDMC-Screenshot-7.1.0"
        }
    },
    "checkver": {
        "url": "https://api.github.com/repos/NoFoolLikeOne/EDMC-Screenshot/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^([\\d.]+[\\-a-z]*)"
    },
    "installer": {
        "script": [
            "# Copy the release over the plugin folder: replaces the plugin's files, keeps files it doesn't ship (your data).",
            "New-Item -ItemType Directory -Path \"$env:LocalAppData\\EDMarketConnector\\plugins\\EDMC-Screenshot\" -Force | Out-Null",
            "Copy-Item -Path \"$dir\\*\" -Destination \"$env:LocalAppData\\EDMarketConnector\\plugins\\EDMC-Screenshot\" -Recurse -Force -Exclude manifest.json,install.json"
        ]
    },
    "uninstaller": {
        "script": [
            "# Scoop runs this on update and on uninstall alike. It removes only the files this version shipped,",
            "# so data the plugin keeps in its folder (settings, databases, routes) survives both.",
            "$plugin = \"$env:LocalAppData\\EDMarketConnector\\plugins\\EDMC-Screenshot\"",
            "Get-ChildItem -LiteralPath $dir -Recurse -File -Exclude manifest.json,install.json | ForEach-Object {",
            "    Remove-Item -LiteralPath (Join-Path $plugin $_.FullName.Substring($dir.Length + 1)) -Force -ErrorAction SilentlyContinue",
            "}",
            "# Then remove folders left empty, deepest first.",
            "if (Test-Path -LiteralPath $plugin) {",
            "    Get-ChildItem -LiteralPath $plugin -Recurse -Directory | Sort-Object { $_.FullName.Length } -Descending |",
            "        Where-Object { -not (Get-ChildItem -LiteralPath $_.FullName -Force) } | Remove-Item -Force",
            "    if (-not (Get-ChildItem -LiteralPath $plugin -Force)) { Remove-Item -LiteralPath $plugin -Force }",
            "}"
        ]
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/NoFoolLikeOne/EDMC-Screenshot/archive/refs/tags/$version.zip",
                "extract_dir": "EDMC-Screenshot-$version"
            }
        }
    }
}
