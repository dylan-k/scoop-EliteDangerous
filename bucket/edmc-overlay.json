{
    "version": "1.0.6",
    "description": "EDMC plugin: draws text and shapes over the game window for other plugins (EDMCOverlay).",
    "homepage": "https://github.com/inorton/EDMCOverlay",
    "license": "Unknown",
    "depends": "edmc",
    "architecture": {
        "64bit": {
            "url": "https://github.com/inorton/EDMCOverlay/releases/download/1.0.6/EDMCOverlay-1.0.6.msi",
            "hash": "bbda36e4332e9f182b308ea2e1552e24b1abd33ede0443a8ed6fe5f948df4ea0",
            "extract_dir": "EDMCOverlay"
        }
    },
    "installer": {
        "script": [
            "# EDMC's plugins folder is often a link (scoop persist, a synced drive). Work in its real folder:",
            "# through a symbolic link, New-Item can report success and create nothing.",
            "$base = \"$env:LocalAppData\\EDMarketConnector\"",
            "$root = Get-Item -LiteralPath $base -Force -ErrorAction SilentlyContinue",
            "if ($root -and $root.LinkType -and $root.Target) { $base = @($root.Target)[0] }",
            "$plugins = Join-Path $base 'plugins'",
            "$link = Get-Item -LiteralPath $plugins -Force -ErrorAction SilentlyContinue",
            "if ($link -and $link.LinkType -and $link.Target) { $plugins = @($link.Target)[0] }",
            "$plugin = Join-Path $plugins 'EDMCOverlay'",
            "# Copy the release over the plugin folder: replaces the plugin's files, keeps files it doesn't ship (your data).",
            "[void][IO.Directory]::CreateDirectory($plugin)",
            "Copy-Item -Path \"$dir\\*\" -Destination $plugin -Recurse -Force -Exclude manifest.json,install.json,scoop-manifest.json,scoop-install.json",
            "if (-not (Test-Path -LiteralPath (Join-Path $plugin 'load.py'))) { throw \"Plugin files didn't reach $plugin\" }"
        ]
    },
    "uninstaller": {
        "script": [
            "# EDMC's plugins folder is often a link (scoop persist, a synced drive). Work in its real folder:",
            "# through a symbolic link, New-Item can report success and create nothing.",
            "$base = \"$env:LocalAppData\\EDMarketConnector\"",
            "$root = Get-Item -LiteralPath $base -Force -ErrorAction SilentlyContinue",
            "if ($root -and $root.LinkType -and $root.Target) { $base = @($root.Target)[0] }",
            "$plugins = Join-Path $base 'plugins'",
            "$link = Get-Item -LiteralPath $plugins -Force -ErrorAction SilentlyContinue",
            "if ($link -and $link.LinkType -and $link.Target) { $plugins = @($link.Target)[0] }",
            "$plugin = Join-Path $plugins 'EDMCOverlay'",
            "# Scoop runs this on update and on uninstall alike. It removes only the files this version shipped,",
            "# so data the plugin keeps in its folder (settings, databases, routes) survives both.",
            "Get-ChildItem -LiteralPath $dir -Recurse -File -Exclude manifest.json,install.json,scoop-manifest.json,scoop-install.json | ForEach-Object {",
            "    Remove-Item -LiteralPath (Join-Path $plugin $_.FullName.Substring($dir.Length + 1)) -Force -ErrorAction SilentlyContinue",
            "}",
            "# Then remove folders left empty, deepest first.",
            "if (Test-Path -LiteralPath $plugin) {",
            "    Get-ChildItem -LiteralPath $plugin -Recurse -Directory | Sort-Object { $_.FullName.Length } -Descending |",
            "        Where-Object { -not (Get-ChildItem -LiteralPath $_.FullName -Force) } | Remove-Item -Force",
            "    if (-not (Get-ChildItem -LiteralPath $plugin -Force)) { Remove-Item -LiteralPath $plugin -Force }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://api.github.com/repos/inorton/EDMCOverlay/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v?([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/inorton/EDMCOverlay/releases/download/$version/EDMCOverlay-$version.msi",
                "extract_dir": "EDMCOverlay"
            }
        }
    }
}
